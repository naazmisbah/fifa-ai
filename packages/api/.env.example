# Copy to .env (git-ignored) and export before `npm run dev`, or set in your host.

# Google Gemini API key. Optional: without it the concierge answers from the
# deterministic heuristic engine, so the service always works.
GEMINI_API_KEY=

# Port the API listens on.
PORT=8787

# Browser origin allowed by CORS (the web dev server by default).
CORS_ORIGIN=http://localhost:5173
